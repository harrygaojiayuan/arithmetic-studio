{
  "name": "arithmetic-studio",
  "version": "1.1.0",
  "description": "离线算数练习室：自定义位数、限时练习、个人排行榜。支持 Windows 和 macOS。",
  "author": "harrygaojiayuan",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "preview": "python3 -m http.server 5173 --bind 127.0.0.1 --directory dist",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/app.mjs && node --check dist/core.mjs && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/store.cjs && node --check desktop/smoke.cjs",
    "icons": "node scripts/make-icons.mjs",
    "build:win": "npm run icons && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.arithmeticstudio.Windows",
    "productName": "算数练习室",
    "executableName": "ArithmeticStudio",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["desktop/**", "dist/**", "assets/icon.png", "assets/icon.ico", "package.json"],
    "artifactName": "ArithmeticStudio-${version}-windows-${arch}.${ext}",
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["zh_CN", "en_US"]
    }
  }
}
